MYSQL_DATABASE=e-cart
MYSQL_USER=ecart_user
MYSQL_PASSWORD=replace_with_a_secure_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_secure_password

# Local IntelliJ/Maven URL. Compose overrides this with the mysql service hostname.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/e-cart
SPRING_DATASOURCE_USERNAME=ecart_user
SPRING_DATASOURCE_PASSWORD=replace_with_a_secure_password

APP_PORT=8080
SERVER_PORT=8080
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=ecart_user
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_EXPIRATION_SECONDS=3600
